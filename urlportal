# }}}
#-------- program variable {{{
#-------------------------------------------
save_dir="${HOME}/Downloads"
mybkmark="$HOME/.config/surfraw/bookmarks"

audio_cli_mpv="mpv --no-video --loop"
audio_tui_nvlc="nvlc --no-video --loop"
bookmarker_linkding="linkding --config ~/.config/linkding-cli/config.json bookmarks create"
browser_gui_firefox="firefox"
browser_gui_firefox_private="firefox --private-window"
browser_gui_brave="brave-browser"
browser_gui_brave_private="brave-browser --incognito"
browser_gui_chromium="chromium"
browser_gui_chromium_private="chromium --incognito"
browser_tui_w3m="w3m"
browser_tui_chawan="cha"
browser_tui_lynx="lynx"
browser_tui_elinks="elinks"
browser_tui_links="links"
readerview_rdrview="rdrview -B w3m"
dl_aria2p="aria2p add"
dl_aria2tui="aria2tui --add_download"
dl_megatools="megadl --limit-speed=3000 --path=$save_dir"
dl_plowshare="plowdown --max-rate=3000K --output-directory=$save_dir"
dl_transmission="transmission-remote --add"
# dl_transmission_server="transmission-remote 192.168.1.131:9091 --auth username:password --add"
dl_transmission_server="tsm-add-anubis"
dl_wget="wget --continue --directory-prefix $save_dir"
dl_surge="surge --output $save_dir add"
# dl_surge="surge --output ~/.cyberbay/surgebay add"
dl_ytdlp="yt-dlp --output $save_dir/'%(title)s.%(ext)s'"
img_viewer_gui_feh="feh --fullscreen"
img_viewer_cli_chafa="chafa --clear --duration infinite"
queue_dl="TS_SOCKET=/tmp/dl tsp"
queue_media="TS_SOCKET=/tmp/media tsp"
show_comment_youtube="pipe-viewer --ytdl-cmd yt-dlp --ytdlp-comments --max-comments 6 --comments"
st_chromecast="catt cast"
st_chromecast_queue="catt add"
st_kodi="kodi-cli -y"
st_kodi_queue="kodi-cli -q"
video_cli_mpv="mpv --loop --vo=tct"
video_gui_mpv="mpv --force-window --ontop --no-border --autofit=500x280 --geometry=-15-53"
## get display list --> $ mpv --drm-connector=help | grep -i "(connected)"
video_tty_mpv="mpv --loop --vo=drm --gpu-context=drm --drm-connector=HDMI-A-1"
video_img_mpv="mpv --force-window --fullscreen --loop --quiet --ontop --no-border"
# }}}
#-------- choice menu {{{
#------------------------------------------------------
# clear terminal and tmux scrollback screens
printf "\033c"
tmux clear-history 2>/dev/null

choice=$(cat <<_TXTBLOCK_
yy -- yank url to clipboard
vv -- video: gui - mpv
vi -- video: gui - mpv (loop/meme/image/gif)
vc -- video: cli - mpv (ascii)
vf -- video: framebuffer - mpv (video/image/gif)
aa -- audio: cli - mpv (radio/mp3)
au -- audio: tui - nvlc (podcast/radio/mp3/playlist)
ii -- imageviewer: cli - chafa (image/gif)
ig -- imageviewer: gui - feh
rv -- readerview: tui - rdrview
ww -- web-browser: tui - w3m
wm -- web-browser: tui - w3m wayback machine
wc -- web-browser: tui - chawan
wl -- web-browser: tui - lynx
we -- web-browser: tui - elinks
wi -- web-browser: tui - links
wf -- web-browser: gui - firefox
wp -- web-browser: gui - firefox private incognito
wk -- web-browser: gui - firefox wayback machine
wb -- web-browser: gui - brave
wo -- web-browser: gui - brave private incognito
wv -- web-browser: gui - brave wayback machine
wr -- web-browser: gui - chromium
wn -- web-browser: gui - chromium private incognito
wa -- web-browser: gui - chromium wayback machine
bb -- bookmark: surfraw
bl -- bookmark: linkding
uu -- show-comments: youtube - pipe-viewer [enter:next | ;r:back]
da -- downloader: daemon - aria2p
di -- downloader: daemon - aria2tui
dr -- downloader: daemon - transmission remote server
dt -- downloader: daemon - transmission local
ds -- downloader: daemon - surge
dm -- downloader: cli - mega.nz
dy -- downloader: cli - yt-dlp
dp -- downloader: cli - plowshare
dw -- downloader: cli - wget
ua -- bulk downloader: daemon - aria2p
ui -- bulk downloader: daemon - aria2tui
us -- bulk downloader: daemon - surge
cc -- stream: chromecast
cq -- stream: chromecast queue
kk -- stream: kodi
kq -- stream: kodi queue
_TXTBLOCK_
)

# }}}
#-------- case statement {{{
#------------------------------------------------------

if [ "$TERM_PROGRAM" = tmux ]; then
  selection="$(printf %s "$choice" | fzf-tmux -p -h 75% --preview "printf %s '$lnk'" | cut -d ' ' -f1)"
else
  selection="$(printf %s "$choice" | fzf --preview "printf %s '$lnk'" | cut -d ' ' -f1)"
fi

case $selection in
  yy) # X11=xsel/xclip; wayland=wl-copy; winos(vista+)=clip; cygwin=/dev/clipboard; macos=pbcopy; android=termux
    printf %s "$lnk" | xsel -b 2>/dev/null || printf %s "$lnk" | xclip -selection clipboard -rmlastnl 2>/dev/null
    printf %s "$lnk" | wl-copy 2>/dev/null
    printf %s "$lnk" | clip 2>/dev/null
    (printf %s "$lnk" > /dev/clipboard) 2>/dev/null
    printf %s "$lnk" | pbcopy 2>/dev/null
    printf %s "$lnk" | termux-clipboard-set 2>/dev/null
    (printf %s "$lnk" | tmux load-buffer -) 2>/dev/null
    ;;
  ua)
      hyperlink=$(lynx -listonly -nonumbers -dump "$lnk" | fzf --multi --prompt="aria2p>>> add link(s): ")
      [ -z "$hyperlink" ] && exit
      echo "$hyperlink" | while read -r lnk ; do $dl_aria2p "$lnk" ; done
    ;;
  ui)
      hyperlink=$(lynx -listonly -nonumbers -dump "$lnk" | fzf --multi --prompt="aria2tui>>> add link(s): ")
      [ -z "$hyperlink" ] && exit
      echo "$hyperlink" | while read -r lnk ; do $dl_aria2tui "$lnk" ; done
    ;;
  us)
      hyperlink=$(lynx -listonly -nonumbers -dump "$lnk" | fzf --multi --prompt="surge>>> add link(s): ")
      [ -z "$hyperlink" ] && exit
      echo "$hyperlink" | while read -r lnk ; do $dl_surge "$lnk" ; done
    ;;
  au)
      if [ "$TERM_PROGRAM" = tmux ]; then
        tmux new-window -n audio-tui && tmux send-keys "$audio_tui_nvlc '$lnk' && tmux kill-pane" C-m
      else
        eval "$audio_tui_nvlc '$lnk'"
      fi
    ;;
  aa) # if playerctl is installed then run audio in background and use playerctl to control
      if [ -x "$(command -v playerctl)" ]; then
        eval "$audio_cli_mpv '$lnk'" > /dev/null 2>&1 &
      elif [ "$TERM_PROGRAM" = tmux ]; then
        tmux split-window -v -l 10 && tmux send-keys "$audio_cli_mpv '$lnk' && tmux kill-pane" C-m
      else
        eval "$audio_cli_mpv '$lnk'"
      fi
    ;;
  bl)
      printf '%s\n' "Add to LINKDING Bookmarks"
      printf '%s\n' "URL: $lnk"
      printf '%s\n' "------------------------"
      printf '%s\n' 'enter in tag(s) (comma-separated)'
      read -r tags
      tags=${tags//[[:blank:]]/}
      [ -z "$tags" ] && printf '%s\n' 'No tags entered, exiting ...3..2..1' && sleep 3 && exit
      printf '\n'
      printf '%s\n' 'share this bookmark? [y/n]'
      read -r shared
      shared=${shared//[[:blank:]]/}
      [ -z "$shared" ] && printf '%s\n' 'y/n not entered, exiting ...3..2..1' && sleep 3 && exit
      printf '\n'
      if [[ $shared =~ ^[Yy]$ ]]; then
        eval "$bookmarker_linkding '$lnk' --shared --tags $tags"
        printf '\n'
        printf '%s\n' "Press any key to continue"
        read -rsn1
      else
        eval "$bookmarker_linkding '$lnk' --tags $tags"
        printf '\n'
        printf '%s\n' "Press any key to continue"
        read -rsn1
      fi
    ;;
  bb)
      color_off='\e[0m'
      red='\e[0;31m'
      green='\e[0;32m'
      blue='\e[0;34m'

      echo "ADD BOOKMARK"
      echo "============"
      echo -e "${red}SAVE TO: $mybkmark $color_off"
      echo

      # show current page url and link url if is not empty
      echo -e "${blue}>>> URL: $lnk $color_off"

      #### nickname input
      echo -e "${green}----------------------------------------------------------${color_off}"
      echo -e "${green}>>> 1) Enter nickname for this bookmark. ${red}(single word, no spaces, no symbols)${color_off}"
      set -o vi
      printf "Nickname: " && read -r nickname
      [ -z "$nickname" ] && exit || nickname=$(echo "$nickname" | awk '{print $1}')
      echo

      #### keyword tags input
      echo -e "${green}>>> 2) Enter keyword tag(s) for this bookmark. ${red}(separate each tags with a space)${color_off}"
      printf "Keywords: " && read -r keywords
      echo

      #### if file does not exist then create path
      if [ ! -f "$mybkmark" ]; then
        mkdir -p "$(dirname "$mybkmark")"
      fi

      #### append bookmarks to end of file
      echo "$nickname $lnk $keywords" | xargs >> "$mybkmark"
      echo -e "${blue}Bookmark added: $nickname $lnk $color_off"

    ;;
  uu)
      if [ "$TERM_PROGRAM" = tmux ]; then
        tmux new-window -n youtube-comments && tmux send-keys "$show_comment_youtube '$lnk' 2>/dev/null && tmux kill-pane" C-m
      else
        eval "$show_comment_youtube '$lnk' 2>/dev/null"
      fi
    ;;
  vv) eval "$queue_media $video_gui_mpv '$lnk'" ;;
  vc) eval "$video_cli_mpv '$lnk'" ;;
  vi) $video_img_mpv "$lnk" > /dev/null 2>&1 & ;;
  vf) eval "$video_tty_mpv '$lnk'" ;;
  dt) eval "$dl_transmission '$lnk'" ;;
  dr) eval "$dl_transmission_server '$lnk'" ;;
  dm) eval "$queue_dl $dl_megatools '$lnk'" ;;
  dp) eval "$queue_dl $dl_plowshare '$lnk'" ;;
  dy) eval "$queue_dl $dl_ytdlp '$lnk'" ;;
  dw) eval "$queue_dl $dl_wget '$lnk'" ;;
  ds) eval "$dl_surge '$lnk'" ;;
  da) eval "$dl_aria2p '$lnk'" ;;
  di) eval "$dl_aria2tui '$lnk'" ;;
  rv) $readerview_rdrview "$lnk" ;;
  ww) $browser_tui_w3m "$lnk" ;;
  wm) $browser_tui_w3m "https://web.archive.org/$lnk" ;;
  wc) $browser_tui_chawan "$lnk" ;;
  wl) $browser_tui_lynx "$lnk" ;;
  we) $browser_tui_elinks "$lnk" ;;
  wi) $browser_tui_links "$lnk" ;;
  wf) $browser_gui_firefox "$lnk" ;;
  wp) $browser_gui_firefox_private "$lnk" ;;
  wk) $browser_gui_firefox "https://web.archive.org/$lnk" ;;
  wb) $browser_gui_brave "$lnk" ;;
  wo) $browser_gui_brave_private "$lnk" ;;
  wv) $browser_gui_brave "https://web.archive.org/$lnk" ;;
  wf) $browser_gui_chromium "$lnk" ;;
  wp) $browser_gui_chromium_private "$lnk" ;;
  wk) $browser_gui_chromium "https://web.archive.org/$lnk" ;;
  cc) $st_chromecast "$lnk" ;;
  cq) $st_chromecast_queue "$lnk" ;;
  kk) eval "$st_kodi '$lnk'" ;;
  kq) eval "$st_kodi_queue '$lnk'" ;;
  ig) $img_viewer_gui_feh "$lnk" ;;
  ii) curl "$lnk" | $img_viewer_cli_chafa - ;;
esac

# }}}


