#!/usr/bin/env bash
# desc: open url with your own custom choice menu
# demo: https://youtu.be/6t4i73_YiFc
# depend: fzf coreutils curl
export FZF_DEFAULT_OPTS='--preview-window up,3,wrap,noinfo --prompt="urlportal: " --exact --ignore-case --info=hidden --layout=reverse --tiebreak=index'

